{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "git": {
    "deploymentEnabled": {
      "wip/*": false
    }
  },
  "ignoreCommand": "[ \"${VERCEL_GIT_COMMIT_REF#wip/}\" != \"$VERCEL_GIT_COMMIT_REF\" ]"
}
